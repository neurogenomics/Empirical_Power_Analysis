/*
========================================================================================
    Test profile — runs each module's toy/ fixture through the full DAG
----------------------------------------------------------------------------------------
    Usage: nextflow run main.nf -profile test,docker
           nextflow run main.nf -profile test,apptainer
----------------------------------------------------------------------------------------
    Purpose: verify the pipeline wiring end-to-end on every push via GitHub Actions.
             Uses the pre-existing toy/ directories each pipeline already ships.
========================================================================================
*/

params {
    // Redirect to toy fixtures. We use a channel-safe dummy path so the
    // main-workflow `Channel.fromPath(..., checkIfExists:true)` guard passes
    // even when the toy fixtures directory contains no files yet. Stub
    // process blocks only touch files, so no R data is needed.
    raw_data       = "${projectDir}/R/sharding/toy"
    outdir         = "${projectDir}/test_output"
    tracedir       = "${projectDir}/test_output/pipeline_info"

    // Minimal grid — just enough to exercise the DAG
    n_robustness   = 1
    n_subsamples   = 2

    // Skip heavy rendering in CI
    render_paper   = false
}

// Stub CI runs should not pull the container (image may not be published yet,
// and stub blocks only touch files — no R needed).
process.container   = null
docker.enabled      = false
apptainer.enabled   = false
singularity.enabled = false

process {
    executor    = 'local'
    cpus        = 2
    memory      = '4.GB'
    time        = '30.min'

    // Override per-label tiers for CI
    withLabel: process_heavy            { cpus = 2; memory = '4.GB'; time = '30.min' }
    withLabel: process_high             { cpus = 2; memory = '4.GB'; time = '30.min' }
    withLabel: process_medium           { cpus = 2; memory = '4.GB'; time = '15.min' }
    withLabel: process_memory_intensive { cpus = 2; memory = '4.GB'; time = '15.min' }
}

params {
    max_cpus    = 4
    max_memory  = '8.GB'
    max_time    = '1.h'
}
