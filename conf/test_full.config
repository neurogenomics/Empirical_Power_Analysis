/*
========================================================================================
    Nextflow config file for running full-size tests
========================================================================================
    Runs the complete paper pipeline end-to-end on the full PsychAD cohort
    (all five datasets, all three cell types, 6 robustness runs × 20 subsamples).

    Usage:
        nextflow run neurogenomics/Empirical_Power_Analysis \
            -profile test_full,docker --outdir results_full

    Requirements:
        - Raw data placed in Datalink/raw_data/ (see REPRODUCE.md §1 for file list)
        - At least 200 GB RAM and 64 cores recommended
        - Multi-day wall-clock time for the Cartesian downsampling step
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full PsychAD + cross-dataset reproduction run'

    // Full data — point to the real raw_data directory (must be populated first)
    raw_data     = "${projectDir}/Datalink/raw_data"
    shards_dir   = "${projectDir}/Datalink/Shards"

    // Full grid dimensions (paper settings)
    n_robustness   = 6
    n_subsamples   = 20

    // Enable paper rendering
    render_paper = true

    // Output alongside Datalink/ tree
    outdir = "${projectDir}/Datalink"
}
