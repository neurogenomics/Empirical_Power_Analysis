/*
========================================================================================
    SLURM executor — tuned for Imperial College Research Computing (CX3)
----------------------------------------------------------------------------------------
    Docs: https://icl-rcs-user-guide.readthedocs.io/en/latest/hpc/
    Adjust queue names + clusterOptions for your site if forking this pipeline.
========================================================================================
*/

process {
    executor        = 'slurm'

    // Default queue (Imperial CX3 v1 general queue)
    queue           = { task.memory > 120.GB ? 'v1_largemem72' : 'v1_cpu72' }

    // SLURM account — Imperial CX3 runs on shared projects without per-user
    // accounts, so no -A flag is required by default. Uncomment and set if a
    // future site requires it.
    // clusterOptions  = { "-A ${System.getenv('SLURM_ACCOUNT') ?: ''}" }

    // Scratch space
    scratch         = '/rds/general/ephemeral/user/$USER/ephemeral'

    // Max concurrent jobs the pipeline submits — protects the scheduler
    maxForks        = 200
}

executor {
    name              = 'slurm'
    queueSize         = 200              // concurrent jobs in SLURM queue
    submitRateLimit   = '10 sec'         // throttle sbatch calls
    pollInterval      = '30 sec'
}

// Global resource ceilings for Imperial CX3
// These override the top-level resourceLimits set in nextflow.config.
resourceLimits {
    cpus   = 128
    memory = '920.GB'   // v1_largemem72 node ceiling
    time   = '72.h'
}
