/*
========================================================================================
    Config file for defining DSL2 per module options and publishing paths
========================================================================================
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    // Default publishDir for all processes — results are collected under params.outdir
    publishDir = [
        path: { "${params.outdir}" },
        mode: params.publish_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // ---------------------------------------------------------------------------------
    //  Per-process publish overrides
    //  Each module below customises the publish sub-path to match the Datalink/ tree
    //  that the R scripts write directly.  These overrides ensure that Nextflow's
    //  publishDir copies the staged outputs to the expected location.
    // ---------------------------------------------------------------------------------

    withName: 'SHARDING' {
        publishDir = [
            path: { "${params.outdir}/Shards" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EDA_ROUSSOS' {
        publishDir = [
            path: { "${params.outdir}/Exploratory_Analysis" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FULL_GROUND_TRUTH' {
        publishDir = [
            path: { "${params.outdir}/Full_Ground_Truth" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CARTESIAN_DOWNSAMPLING' {
        publishDir = [
            path: { "${params.outdir}/Cartesian_Downsampling" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DEPTH_EQUALIZATION' {
        publishDir = [
            path: { "${params.outdir}/Depth_Equalization" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'POWER_CURVE_FITTING' {
        publishDir = [
            path: { "${params.outdir}/Power_Curve_Fitting" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DE_DIAGNOSTICS' {
        publishDir = [
            path: { "${params.outdir}/DE_Diagnostics" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BULK_DEG_PROCESSING' {
        publishDir = [
            path: { "${params.outdir}/Bulk_Analysis" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FIGURE_DATA_GENERATION' {
        publishDir = [
            path: { "${params.outdir}/Paper_Source_Data" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RENDER_PAPER' {
        publishDir = [
            path: { "${params.outdir}/Paper" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
