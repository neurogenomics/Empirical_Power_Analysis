/*
========================================================================================
    Empirical Power Analysis — Nextflow Configuration
----------------------------------------------------------------------------------------
    See conf/ for executor- and profile-specific configurations.
========================================================================================
*/

// ======================================================================================
//  Manifest
// ======================================================================================
manifest {
    name            = 'neurogenomics/Empirical_Power_Analysis'
    contributors    = [
        [name: 'Chris Crampton',       affiliation: 'UK DRI, Imperial College London', github: 'https://github.com/ChrisCrampton'],
        [name: 'Salman Fawad',         affiliation: 'UK Biobank'],
        [name: 'Hiranyamaya Dash',     affiliation: 'UK DRI, Imperial College London'],        [name: 'Nathan G. Skene',      affiliation: 'UK DRI, Imperial College London', github: 'https://github.com/nathanskene', orcid: 'https://orcid.org/0000-0002-6807-3180'],
    ]
    homePage        = 'https://github.com/neurogenomics/Empirical_Power_Analysis'
    description     = 'Empirical power analysis for single-cell RNA-seq differential expression'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0-dev'
    doi             = '10.5281/zenodo.TBD'    // mint on first release
}

// ======================================================================================
//  Default parameters (see main.nf for workflow-specific params)
// ======================================================================================
params {
    // Reporting & tracing
    tracedir  = 'results/pipeline_info'

    // Publish mode + outdir
    publish_mode = 'copy'
    outdir       = 'results'

    // Workflow paths (Nextflow 25.10+: must be declared here, not in main.nf,
    // because script-level params{} blocks are deprecated by the strict parser)
    raw_data       = "${projectDir}/Datalink/raw_data"
    shards_dir     = "${projectDir}/Datalink/Shards"

    // Compute
    cores_default  = 16
    cores_heavy    = 64

    // Analysis parameters (override via -c config or --param on CLI)
    downsample_mode = 'cells'   // 'cells' or 'reads'
    n_robustness    = 6
    n_subsamples    = 20

    // Rendering
    render_paper   = true

    // Display help
    help        = false

    // nf-core institutional config options (ignored if custom_config_base is unreachable)
    custom_config_version  = 'master'
    custom_config_base     = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_name        = null
    config_profile_description = null
    config_profile_contact     = null
    config_profile_url         = null
}

// ======================================================================================
//  Load base.config for all profiles (nf-core convention — sets process resource
//  defaults that are then overridden by executor-specific profiles)
// ======================================================================================
includeConfig 'conf/base.config'

// ======================================================================================
//  Resource limits — replaces deprecated params.max_cpus/memory/time
//  Override per-executor in conf/slurm.config or a site-specific config.
// ======================================================================================
resourceLimits {
    cpus   = 64
    memory = '256.GB'
    time   = '72.h'
}

// ======================================================================================
//  Profiles — selected via `-profile <name>[,<name>...]`
// ======================================================================================
profiles {

    // Development/local execution on whatever machine you're on
    standard {
        process.executor = 'local'
    }

    // Imperial CX3 / SLURM HPC
    slurm {
        includeConfig 'conf/slurm.config'
    }

    // Docker (local dev with container)
    docker {
        docker.enabled          = true
        docker.runOptions       = "-u \$(id -u):\$(id -g) -v ${projectDir}:${projectDir}"
        singularity.enabled     = false
        apptainer.enabled       = false
    }

    // Apptainer (HPC container — preferred on shared systems)
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        apptainer.cacheDir      = "${HOME}/.apptainer/cache"
        docker.enabled          = false
    }

    // Conda (fallback if containers unavailable)
    conda {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        apptainer.enabled       = false
    }

    // Test profile — toy data, short walltime, no container required
    test {
        includeConfig 'conf/test.config'
    }

    // Debug profile — verbose logging, no resume
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
    }
}

// ======================================================================================
//  Container images
// ======================================================================================
process {
    container = 'ghcr.io/neurogenomics/empirical_power_analysis:1.0.0-dev'
}

// ======================================================================================
//  Reporting — auto-generated for every run
// ======================================================================================
timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.tracedir}/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace.txt"
    overwrite = true
    fields  = 'task_id,hash,native_id,name,status,exit,realtime,%cpu,rss,vmem'
}
dag {
    enabled = true
    file    = "${params.tracedir}/dag.svg"
    overwrite = true
}

// ======================================================================================
//  Capability declarations
// ======================================================================================
env {
    R_LIBS_USER = '-'   // prevent user's personal R library from contaminating container
}

// ======================================================================================
//  Helper function — cap resource requests at profile max
//  Uses the Nextflow-native resourceLimits block (Nextflow >= 24.04).
// ======================================================================================
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            def limit = workflow.resourceLimits?.memory as nextflow.util.MemoryUnit ?: null
            if (limit && obj.compareTo(limit) == 1) return limit
            else return obj
        } catch (all) {
            println "   ### ERROR ### Max memory limit is not valid; using default: ${obj}"
            return obj
        }
    } else if (type == 'time') {
        try {
            def limit = workflow.resourceLimits?.time as nextflow.util.Duration ?: null
            if (limit && obj.compareTo(limit) == 1) return limit
            else return obj
        } catch (all) {
            println "   ### ERROR ### Max time limit is not valid; using default: ${obj}"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            def limit = workflow.resourceLimits?.cpus as int ?: Integer.MAX_VALUE
            return Math.min(obj, limit)
        } catch (all) {
            println "   ### ERROR ### Max cpus limit is not valid; using default: ${obj}"
            return obj
        }
    }
}
