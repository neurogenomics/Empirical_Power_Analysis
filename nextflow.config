/*
========================================================================================
    Empirical Power Analysis — Nextflow Configuration
----------------------------------------------------------------------------------------
    See conf/ for executor- and profile-specific configurations.
========================================================================================
*/

// ======================================================================================
//  Manifest
// ======================================================================================
manifest {
    name            = 'neurogenomics/Empirical_Power_Analysis'
    author          = 'Chris Crampton, Salman Fawad, Hiru Dash, Nathan Skene'
    homePage        = 'https://github.com/neurogenomics/Empirical_Power_Analysis'
    description     = 'Empirical power analysis for single-cell RNA-seq differential expression'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0-dev'
    doi             = '10.5281/zenodo.TBD'    // mint on first release
}

// ======================================================================================
//  Default parameters (see main.nf for workflow-specific params)
// ======================================================================================
params {
    // Publish mode + outdir (absolute, anchored to projectDir so outputs always
    // land in the repo regardless of caller's cwd)
    publish_mode = 'copy'
    outdir       = "${projectDir}/results"

    // Reporting & tracing — derived from outdir
    tracedir     = "${projectDir}/results/pipeline_info"

    // Max resources — overridden per-executor
    max_cpus    = 64
    max_memory  = '256.GB'
    max_time    = '72.h'

    // Workflow paths (Nextflow 25.10+: must be declared here, not in main.nf,
    // because script-level params{} blocks are deprecated by the strict parser)
    raw_data       = "${projectDir}/Datalink/raw_data"
    shards_dir     = "${projectDir}/Datalink/Shards"

    // Compute
    cores_default  = 16
    cores_heavy    = 64

    // Analysis parameters (override via -c config or --param on CLI)
    downsample_mode = 'cells'   // 'cells' or 'reads'
    n_robustness    = 6
    n_subsamples    = 20

    // Rendering — off by default so a fresh clone without the draft doesn't
    // fail at the last stage. The `iclneuro` / full-run operator enables it
    // explicitly with `--render_paper true`, and shouldRender() in main.nf
    // gates on `paper_final_draft.rmd` actually existing.
    render_paper   = false

    // Display help
    help        = false
}

// ======================================================================================
//  Profiles — selected via `-profile <name>[,<name>...]`
// ======================================================================================
profiles {

    // Development/local execution on whatever machine you're on
    standard {
        includeConfig 'conf/base.config'
        process.executor = 'local'
    }

    // Imperial CX3 / SLURM HPC
    slurm {
        includeConfig 'conf/base.config'
        includeConfig 'conf/slurm.config'
    }

    // ICL Neuro RStudio server — local docker with symlinked Datalink
    iclneuro {
        includeConfig 'conf/base.config'
        includeConfig 'iclneuro.config'
    }

    // Laptop — capped resources so process_heavy doesn't OOM a workstation.
    // Use together with `-profile laptop,docker` (or laptop,standard).
    laptop {
        includeConfig 'conf/base.config'
        params {
            max_cpus   = 8
            max_memory = '32.GB'
            max_time   = '24.h'
            // Downscale the hot loop so it actually fits in memory
            n_robustness = 2
            n_subsamples = 5
        }
        process {
            executor = 'local'
            withLabel: process_heavy {
                cpus   = 8
                memory = '32.GB'
                time   = '24.h'
            }
            withLabel: process_memory_intensive {
                cpus   = 4
                memory = '24.GB'
                time   = '12.h'
            }
            withLabel: process_high {
                cpus   = 6
                memory = '24.GB'
                time   = '12.h'
            }
            withLabel: process_medium {
                cpus   = 4
                memory = '16.GB'
                time   = '8.h'
            }
        }
    }

    // Docker (local dev with container).
    // Notes:
    //   - Mount /tmp from host so DESeq2 / rmarkdown don't exhaust the
    //     container's in-memory /tmp on long runs.
    //   - Bypass the baked-in renv profile (R_PROFILE_USER=/dev/null) and
    //     point R_LIBS directly at the image's renv library. This mirrors
    //     what iclneuro.config does and avoids Nextflow's default
    //     R_LIBS_USER="-" export from breaking package loading.
    //   - If Datalink is a symlink, also mount its target so it resolves
    //     inside the container (add extra -v flags via --dockerExtraMounts).
    docker {
        docker.enabled        = true
        docker.runOptions     = "-u \$(id -u):\$(id -g) -v ${projectDir}:${projectDir} -v /tmp:/tmp -e HOME=/home/rstudio -e R_PROFILE_USER=${projectDir}/.Rprofile -e RENV_PROJECT=${projectDir}"
        singularity.enabled   = false
        apptainer.enabled     = false
        // Use locally-built image by default; override with `process.container`
        // or a config include if pulling from GHCR is preferred.
        process.container     = 'empa:local'
    }

    // Apptainer (HPC container — preferred on shared systems)
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        apptainer.cacheDir      = "${HOME}/.apptainer/cache"
        docker.enabled          = false
    }

    // Conda (fallback if containers unavailable)
    conda {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        apptainer.enabled       = false
    }

    // Test profile — toy data, short walltime, no container required
    test {
        includeConfig 'conf/test.config'
    }

    // Debug profile — verbose logging, no resume
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
    }
}

// ======================================================================================
//  Container images
// --------------------------------------------------------------------------------------
//  The GHCR image (ghcr.io/neurogenomics/empirical_power_analysis:1.0.0-dev) is not
//  reliably published by CI yet — we default to a locally-built `empa:local` so
//  `docker build -t empa:local .` works out of the box. Override from a custom
//  config or the CLI (`-process.container='ghcr.io/...'`) once the GHCR image
//  is stable.
// ======================================================================================
process {
    container = 'empa:local'
}

// ======================================================================================
//  Reporting — auto-generated for every run
// ======================================================================================
timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.tracedir}/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace.txt"
    overwrite = true
    fields  = 'task_id,hash,native_id,name,status,exit,realtime,%cpu,rss,vmem'
}
dag {
    enabled = true
    file    = "${params.tracedir}/dag.svg"
    overwrite = true
}

// ======================================================================================
//  Task environment — empty R_LIBS_USER prevents the host's per-user R library
//  from leaking into the container. The previous value '-' is not a canonical
//  "disable" marker; '' is. (R_LIBS is set explicitly in docker.runOptions so
//  renv's library is found regardless of this setting.)
// ======================================================================================
env {
    R_LIBS_USER = ''
}

// ======================================================================================
//  Helper function — cap resource requests at profile max
// ======================================================================================
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ### Max memory '${params.max_memory}' is not valid; using default: ${obj}"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ### Max time '${params.max_time}' is not valid; using default: ${obj}"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj, params.max_cpus as int)
        } catch (all) {
            println "   ### ERROR ### Max cpus '${params.max_cpus}' is not valid; using default: ${obj}"
            return obj
        }
    }
}
