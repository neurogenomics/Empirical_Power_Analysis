/*
========================================================================================
    Empirical Power Analysis — Nextflow Configuration
----------------------------------------------------------------------------------------
    See conf/ for executor- and profile-specific configurations.
========================================================================================
*/

// ======================================================================================
//  Manifest
// ======================================================================================
manifest {
    name            = 'neurogenomics/Empirical_Power_Analysis'
    author          = 'Chris Crampton, Salman Fawad, Hiru Dash, Nathan Skene'
    homePage        = 'https://github.com/neurogenomics/Empirical_Power_Analysis'
    description     = 'Empirical power analysis for single-cell RNA-seq differential expression'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0-dev'
    doi             = '10.5281/zenodo.TBD'    // mint on first release
}

// ======================================================================================
//  Default parameters (see main.nf for workflow-specific params)
// ======================================================================================
params {
    // Reporting & tracing
    tracedir  = "${params.outdir ?: 'results'}/pipeline_info"

    // Max resources — overridden per-executor
    max_cpus    = 64
    max_memory  = '256.GB'
    max_time    = '72.h'

    // Display help
    help        = false
}

// ======================================================================================
//  Profiles — selected via `-profile <name>[,<name>...]`
// ======================================================================================
profiles {

    // Development/local execution on whatever machine you're on
    standard {
        includeConfig 'conf/base.config'
        process.executor = 'local'
    }

    // Imperial CX3 / SLURM HPC
    slurm {
        includeConfig 'conf/base.config'
        includeConfig 'conf/slurm.config'
    }

    // Docker (local dev with container)
    docker {
        docker.enabled          = true
        docker.runOptions       = '-u $(id -u):$(id -g)'
        singularity.enabled     = false
        apptainer.enabled       = false
    }

    // Apptainer (HPC container — preferred on shared systems)
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        apptainer.cacheDir      = "${HOME}/.apptainer/cache"
        docker.enabled          = false
    }

    // Conda (fallback if containers unavailable)
    conda {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        apptainer.enabled       = false
    }

    // Test profile — toy data, short walltime, no container required
    test {
        includeConfig 'conf/test.config'
    }

    // Debug profile — verbose logging, no resume
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
    }
}

// ======================================================================================
//  Container images
// ======================================================================================
process {
    container = 'ghcr.io/neurogenomics/empirical_power_analysis:1.0.0-dev'
}

// ======================================================================================
//  Reporting — auto-generated for every run
// ======================================================================================
timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.tracedir}/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace.txt"
    overwrite = true
    fields  = 'task_id,hash,native_id,name,status,exit,realtime,%cpu,rss,vmem'
}
dag {
    enabled = true
    file    = "${params.tracedir}/dag.svg"
    overwrite = true
}

// ======================================================================================
//  Capability declarations
// ======================================================================================
env {
    R_LIBS_USER = '-'   // prevent user's personal R library from contaminating container
}

// ======================================================================================
//  Helper function — cap resource requests at profile max
// ======================================================================================
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ### Max memory '${params.max_memory}' is not valid; using default: ${obj}"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ### Max time '${params.max_time}' is not valid; using default: ${obj}"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj, params.max_cpus as int)
        } catch (all) {
            println "   ### ERROR ### Max cpus '${params.max_cpus}' is not valid; using default: ${obj}"
            return obj
        }
    }
}
