resourceLimits {
    cpus   = 48
    memory = '200.GB'
    time   = '96.h'
}

process {
    executor = 'local'

    withLabel: process_heavy {
        cpus   = 48
        memory = '200.GB'
        time   = '72.h'
    }
    withLabel: process_memory_intensive {
        memory = '200.GB'
    }
}

docker {
    enabled   = true
    // Nextflow exports R_LIBS_USER="-" inside the container (standard Nextflow
    // behaviour for R), which disables the user library and prevents renv's
    // activate.R from finding its library path. Workaround: set R_LIBS directly
    // (higher priority than R_LIBS_USER, not overridden by Nextflow) to the
    // renv library baked into the image at build time, and bypass the profile
    // entirely so renv activation is not required. Also mount
    // /mnt/data/shared/poweranalysis so Datalink symlinks resolve inside the
    // container (Datalink is a symlink to that path on the host).
    runOptions = "-u \$(id -u):\$(id -g) -v ${projectDir}:${projectDir} -v /mnt/data/shared/poweranalysis:/mnt/data/shared/poweranalysis -e HOME=/home/rstudio -e R_PROFILE_USER=/dev/null -e R_LIBS=/home/rstudio/renv/library/linux-ubuntu-noble/R-4.5/x86_64-pc-linux-gnu:/usr/local/lib/R/site-library:/usr/local/lib/R/library"
}

// Use the locally-built image (built with: docker build -t empa:local .)
// instead of pulling from GHCR. Comment this out if you want the remote image.
process.container = 'empa:local'
