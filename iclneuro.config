// ICL Neuro RStudio server profile.
// Loaded via `-profile iclneuro` (which includes base.config, then this file).
// Datalink on the server is a symlink to /mnt/data/shared/poweranalysis, so
// the host path must be bind-mounted into the container for R to follow it.

params {
    max_cpus   = 48
    max_memory = '200.GB'
    max_time   = '96.h'
}

process {
    executor = 'local'

    withLabel: process_heavy {
        cpus   = 48
        memory = '200.GB'
        time   = '72.h'
    }
    withLabel: process_memory_intensive {
        memory = '200.GB'
    }
}

docker {
    enabled   = true
    // See comment in nextflow.config's docker profile. This variant adds the
    // shared Datalink target mount that only exists on the ICL server.
    runOptions = "-u \$(id -u):\$(id -g) -v ${projectDir}:${projectDir} -v /tmp:/tmp -v /mnt/data/shared/poweranalysis:/mnt/data/shared/poweranalysis -e HOME=/home/rstudio -e R_PROFILE_USER=${projectDir}/.Rprofile -e RENV_PROJECT=${projectDir}"
}

// Use the locally-built image by default on this server.
process.container = 'empa:local'
