params {
    max_cpus   = 48
    max_memory = '200.GB'
    max_time   = '96.h'
}

process {
    executor = 'local'

    withLabel: process_heavy {
        cpus   = 48
        memory = '200.GB'
        time   = '72.h'
    }
    withLabel: process_memory_intensive {
        memory = '200.GB'
    }
}

docker {
    enabled   = true
    runOptions = '-u $(id -u):$(id -g)'
}

// If you built the image locally with `docker build -t empa:local .`
// uncomment the next line to use it instead of pulling from GHCR:
// process.container = 'empa:local'
