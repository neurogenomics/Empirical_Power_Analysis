#!/usr/bin/env bash
# ==============================================================================
# XGBoost realistic-grid reweighting sweep -- Stage B (search). Imperial CX3.
# ==============================================================================
# Copy of cx3-xgb-search.pbs, adapted for the n_cells >= 100 realistic sub-grid
# with a 36-way {12 hyperparameter configs x 3 alphas} array. Each task trains
# ONE combined config (row k of the expanded param_grid in 02_Fit_XGBoost.R),
# writes booster + oof_predictions.qs to the config_<k> dir, and stages ONE
# per-config tar out to RDS. See xgboost_reweighting_design.md §6.7 for scope.
#
#   IN  (RDS): HPC_XGB_Input/xgb-aggregated-<tag>.tar         (Stage A -- unchanged)
#              (data payload contains aggregated_fitting_data_realistic.qs
#               produced by R/power_curve_fitting/01e_Filter_Realistic.R)
#   OUT (RDS): HPC_XGB_Search/incoming/<tag>/config_<k>.tar
#              (member: Power_Curve_Fitting/Models/xgboost/realistic/search/config_<k>/)
#
# Submit (36-config grid; all tasks concurrent):
#   qsub -v EPA_SIF=$PWD/epa-cx3-2026-07-19.sif,EPA_DATALINK=$PWD/Datalink \
#        hpc/cx3-xgb-realistic-search.pbs
# ==============================================================================
#PBS -N epa-xgb-realistic-search
#PBS -l select=1:ncpus=8:mem=64gb
# Realistic sub-grid has fewer rows than the full grid. Empirically each task
# tops out around 30 min even for the alpha=1 pass with amplified tail-bin
# gradients. 1h is a comfortable ceiling and keeps the queuer happy (short
# queue tier). Bump back up only if a config genuinely times out.
#PBS -l walltime=01:00:00
#PBS -J 1-36
#PBS -j oe

set -euo pipefail

: "${EPA_SIF:?set EPA_SIF to the apptainer .sif path}"
: "${EPA_DATALINK:?set EPA_DATALINK to the RDS Datalink path}"
EPA_DE_METHODS="${EPA_DE_METHODS:-deseq2,edger,limma}"
EPA_NCPUS="${EPA_NCPUS:-8}"
_safe_methods="${EPA_DE_METHODS//,/-}"
EPA_XGB_TAG="${EPA_XGB_TAG:-${_safe_methods}_runs01-10}"

cd "${PBS_O_WORKDIR:-$PWD}"
module load apptainer 2>/dev/null || true

WORKSPACE="${PBS_O_WORKDIR:-$PWD}"
AGG_TAR="$EPA_DATALINK/HPC_XGB_Input/xgb-aggregated-${EPA_XGB_TAG}.tar"
SEARCH_INCOMING="$EPA_DATALINK/HPC_XGB_Search/incoming/$EPA_XGB_TAG-realistic"

IDX="${PBS_ARRAY_INDEX:-1}"
LOCAL_DATALINK="$TMPDIR/epa-xgb-realistic-search-${IDX}/Datalink"
mkdir -p "$LOCAL_DATALINK" "$TMPDIR/home" "$SEARCH_INCOMING"

echo "================ EPA xgb-realistic-search ================"
echo "config index  : $IDX"
echo "aggregated tar: $AGG_TAR"
echo "search out    : $SEARCH_INCOMING/config_${IDX}.tar"
echo "==========================================================="

# ---- skip if this config already banked ---------------------------------------
if [ -f "$SEARCH_INCOMING/config_${IDX}.tar" ]; then
  echo "SKIP: config $IDX already complete"
  exit 0
fi

# ---- stage aggregated data ----------------------------------------------------
[ -f "$AGG_TAR" ] || { echo "FATAL: aggregated tar missing: $AGG_TAR (Stage A must include the realistic .qs)" >&2; exit 3; }
if tar tf "$AGG_TAR" | grep -qE '(^/|(^|/)\.\.(/|$))'; then
  echo "FATAL: unsafe path in $AGG_TAR" >&2; exit 4
fi
tar xf "$AGG_TAR" -C "$LOCAL_DATALINK"

# Verify the filtered .qs is present (should have been produced by
# R/power_curve_fitting/01e_Filter_Realistic.R and included in Stage A).
REAL_QS="$LOCAL_DATALINK/Power_Curve_Fitting/Fitting_Data/aggregated_fitting_data_realistic.qs"
[ -f "$REAL_QS" ] || { echo "FATAL: aggregated_fitting_data_realistic.qs missing from staged data; run 01e_Filter_Realistic.R before Stage A." >&2; exit 3; }

# ---- train exactly this config on the realistic sub-grid ----------------------
apptainer exec --cleanenv --no-home \
  --bind "$WORKSPACE:/workspace" \
  --bind "$LOCAL_DATALINK:/workspace/Datalink" \
  --env POWER_ANALYSIS_ROOT=/workspace \
  --env HOME="$TMPDIR/home" \
  --env XGB_CONFIG_INDEX="$IDX" \
  --env XGB_MODEL_SUBDIR="realistic" \
  --env XGB_FITTING_DATA="aggregated_fitting_data_realistic.qs" \
  --env XGB_NTHREAD="$EPA_NCPUS" \
  --env RENV_CONFIG_AUTOLOADER_ENABLED=FALSE \
  "$EPA_SIF" \
  Rscript /workspace/R/power_curve_fitting/02_Fit_XGBoost.R

# ---- stage out ONE config tar to RDS (atomic) ---------------------------------
CFG_REL="Power_Curve_Fitting/Models/xgboost/realistic/search/config_${IDX}"
[ -d "$LOCAL_DATALINK/$CFG_REL" ] || { echo "FATAL: config $IDX produced no output dir" >&2; exit 5; }
final="$SEARCH_INCOMING/config_${IDX}.tar"
tmp="$SEARCH_INCOMING/.config_${IDX}.$$.partial.tar"
( cd "$LOCAL_DATALINK" && tar -cf "$tmp" "$CFG_REL" )
mv -f "$tmp" "$final"
echo "CONFIG TAR -> $final"

rm -rf "$LOCAL_DATALINK" 2>/dev/null || true
echo "================ xgb-realistic-search done index $IDX ================"
