#!/usr/bin/env bash
# ==============================================================================
# XGBoost power model — Stage D: SHAP figures. Imperial CX3.
# ==============================================================================
# Single compute-node job. Turns the Stage A/B/C artifacts into paper figures by
# running 04_SHAP_Figures.R (NO model re-fitting):
#   SET 1  beeswarm of the promoted (winning) booster
#   SET 2  per-feature SHAP dependence overlaid across all 12 search configs
#          + cross-config feature-importance stability
# The R script writes the PNGs and tars them itself; this wrapper only stages the
# inputs in and moves the produced figure tar out to RDS (small-file rule: one
# tar in, one tar out; untar on the server to expand to figures).
#
#   IN  (RDS): HPC_XGB_Input/xgb-aggregated-<tag>.tar        (Stage A)
#              HPC_XGB_Model/xgb-model-<tag>.tar             (Stage C — winner)
#              HPC_XGB_Search/incoming/<tag>/config_*.tar    (Stage B — 12 configs)
#   OUT (RDS): HPC_XGB_Figures/shap-figures-<tag>.tar
#                (member: Power_Curve_Fitting/Models/xgboost/shap_figures/)
#
# Submit (after Stage C has produced the model tar):
#   qsub -v EPA_SIF=$PWD/epa-cx3-2026-07-19.sif,EPA_DATALINK=$PWD/Datalink \
#        hpc/cx3-xgb-shap.pbs
# ==============================================================================
#PBS -N epa-xgb-shap
#PBS -l select=1:ncpus=8:mem=64gb
# TreeSHAP on subsamples (winner beeswarm reuses the saved shap_values.qs; the
# 12-config overlay is predcontrib on a shared 50k-row subsample), so this is
# lighter than the Stage C OOF refit. 4h is ample headroom; <=8h keeps it
# short-queue eligible for a fast queue start.
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail

: "${EPA_SIF:?set EPA_SIF to the apptainer .sif path}"
: "${EPA_DATALINK:?set EPA_DATALINK to the RDS Datalink path}"
EPA_DE_METHODS="${EPA_DE_METHODS:-deseq2,edger,limma}"
EPA_NCPUS="${EPA_NCPUS:-8}"
EPA_XGB_SHAP_MAX_ROWS="${EPA_XGB_SHAP_MAX_ROWS:-200000}"
_safe_methods="${EPA_DE_METHODS//,/-}"
EPA_XGB_TAG="${EPA_XGB_TAG:-${_safe_methods}_runs01-10}"

cd "${PBS_O_WORKDIR:-$PWD}"
module load apptainer 2>/dev/null || true

WORKSPACE="${PBS_O_WORKDIR:-$PWD}"
AGG_TAR="$EPA_DATALINK/HPC_XGB_Input/xgb-aggregated-${EPA_XGB_TAG}.tar"
MODEL_TAR="$EPA_DATALINK/HPC_XGB_Model/xgb-model-${EPA_XGB_TAG}.tar"
SEARCH_INCOMING="$EPA_DATALINK/HPC_XGB_Search/incoming/$EPA_XGB_TAG"
FIG_OUT_DIR="$EPA_DATALINK/HPC_XGB_Figures"
LOCAL_DATALINK="$TMPDIR/epa-xgb-shap/Datalink"

mkdir -p "$LOCAL_DATALINK" "$TMPDIR/home" "$FIG_OUT_DIR"

FINAL_FIG_TAR="$FIG_OUT_DIR/shap-figures-${EPA_XGB_TAG}.tar"

echo "================ EPA xgb-shap ================"
echo "aggregated tar: $AGG_TAR"
echo "model tar     : $MODEL_TAR"
echo "search tars   : $SEARCH_INCOMING"
echo "figures out   : $FINAL_FIG_TAR"
echo "=============================================="

# ---- resume: skip if the figure tar already exists on RDS ---------------------
if [ -f "$FINAL_FIG_TAR" ]; then
  echo "RESUME: figure tar already present — nothing to do."
  echo "  $FINAL_FIG_TAR"
  echo "================ xgb-shap: already complete ================"
  exit 0
fi

# ---- safe-extract helper (reject absolute / .. paths) -------------------------
safe_extract() {
  local t="$1"
  if tar tf "$t" | grep -qE '(^/|(^|/)\.\.(/|$))'; then
    echo "FATAL: unsafe path in $t" >&2; exit 4
  fi
  tar xf "$t" -C "$LOCAL_DATALINK"
}

# ---- stage aggregated data (Stage A) ------------------------------------------
[ -f "$AGG_TAR" ] || { echo "FATAL: aggregated tar missing: $AGG_TAR (run Stage A first)" >&2; exit 3; }
safe_extract "$AGG_TAR"

# ---- stage the promoted winner (Stage C) --------------------------------------
[ -f "$MODEL_TAR" ] || { echo "FATAL: model tar missing: $MODEL_TAR (run Stage C first)" >&2; exit 3; }
safe_extract "$MODEL_TAR"

# ---- stage every search config (Stage B) — needed for the cross-config overlay -
shopt -s nullglob
cfg_tars=("$SEARCH_INCOMING"/config_*.tar)
[ ${#cfg_tars[@]} -gt 0 ] || { echo "FATAL: no config tars in $SEARCH_INCOMING (run Stage B first)" >&2; exit 3; }
for t in "${cfg_tars[@]}"; do
  safe_extract "$t"
done
echo "staged ${#cfg_tars[@]} config tar(s)"

# ---- make SHAP figures --------------------------------------------------------
apptainer exec --cleanenv --home "$TMPDIR/home" \
  --bind "$WORKSPACE:/workspace" \
  --bind "$LOCAL_DATALINK:/workspace/Datalink" \
  --env POWER_ANALYSIS_ROOT=/workspace \
  --env EPA_XGB_TAG="$EPA_XGB_TAG" \
  --env XGB_NTHREAD="$EPA_NCPUS" \
  --env XGB_SHAP_MAX_ROWS="$EPA_XGB_SHAP_MAX_ROWS" \
  --env RENV_CONFIG_AUTOLOADER_ENABLED=FALSE \
  "$EPA_SIF" \
  Rscript /workspace/R/power_curve_fitting/04_SHAP_Figures.R

# ---- stage out the figure tar the script produced (atomic) --------------------
FIG_REL="Power_Curve_Fitting/Models/xgboost/shap-figures-${EPA_XGB_TAG}.tar"
[ -f "$LOCAL_DATALINK/$FIG_REL" ] || { echo "FATAL: no figure tar at $FIG_REL" >&2; exit 5; }
tmp="$FIG_OUT_DIR/.shap-figures-${EPA_XGB_TAG}.$$.partial.tar"
cp -f "$LOCAL_DATALINK/$FIG_REL" "$tmp"
mv -f "$tmp" "$FINAL_FIG_TAR"
echo "FIGURE TAR -> $FINAL_FIG_TAR"

rm -rf "$LOCAL_DATALINK" 2>/dev/null || true
echo "================ xgb-shap done ================"
