#!/usr/bin/env bash
# ==============================================================================
# EPA ground truth (step 1) + HPC job manifests (step 1.5) — Imperial CX3
# ==============================================================================
# REBUILT 2026-06-29 (faithful reconstruction; originals lost, see cx3-grid.pbs
# header). Produces, on RDS, ONE control tar that every grid array task copies
# to its compute node and unpacks alongside the shard tars:
#   IN : shard tars (Shards_tar/<CT>_<Dataset>.tar)  [staged to LOCAL scratch]
#   OUT: HPC_Control_Tar/epa-control-<tag>.tar       [manifests + ground truth]
# Never detar onto RDS. Never read loose shards off RDS. Step 1 reads ~1,300
# shards per cell type — that MUST happen against node-local $TMPDIR, not RDS.
#
# Submit (full 1..10):
#   qsub -v EPA_N_CHUNKS=40,EPA_SIF=$PWD/epa-cx3-2026-07-19.sif,EPA_DATALINK=$PWD/Datalink \
#        hpc/cx3-gt-manifest.pbs
# Incremental (runs 6-10 only, after 1-5 banked):
#   qsub -v EPA_RUN_START=6,EPA_RUN_END=10,EPA_N_RUNS=10,EPA_N_CHUNKS=40,\
# EPA_SIF=$PWD/epa-cx3-2026-07-19.sif,EPA_DATALINK=$PWD/Datalink hpc/cx3-gt-manifest.pbs
# Separate dreamlet grid: add EPA_DE_METHODS=dreamlet (different tag => no clash).
#
# Run this BEFORE the matching grid array, with the SAME EPA_RUN_START/END +
# EPA_DE_METHODS (the grid derives the same tag and reads epa-control-<tag>.tar).
# Ground truth is mode-independent (built once per requested run); the manifest
# is per-mode (cells + reads) and embeds the run range + EPA_N_CHUNKS in its
# name, so rebuild it here whenever you change the run range or chunk count.
# ==============================================================================
#PBS -N epa-gt-manifest
#PBS -l select=1:ncpus=8:mem=200gb
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

: "${EPA_SIF:?set EPA_SIF to the apptainer .sif path}"
: "${EPA_DATALINK:?set EPA_DATALINK to the RDS Datalink path}"
EPA_N_CHUNKS="${EPA_N_CHUNKS:-40}"
EPA_SHARD_DATASET="${EPA_SHARD_DATASET:-Roussos}"
EPA_DE_METHODS="${EPA_DE_METHODS:-deseq2,edger,limma}"
EPA_NCPUS="${EPA_NCPUS:-8}"

# Robustness run range — generate ground truth + manifests for runs
# EPA_RUN_START..EPA_RUN_END only (defaults to the full 1..EPA_N_RUNS set).
# For an incremental 6-10 extension set EPA_RUN_START=6 EPA_RUN_END=10; runs 1-5
# are deterministic and untouched. MUST match the values passed to cx3-grid.pbs.
EPA_RUN_START="${EPA_RUN_START:-1}"
EPA_RUN_END="${EPA_RUN_END:-10}"
EPA_N_RUNS="${EPA_N_RUNS:-10}"

# Grid tag — namespaces the control tar so independent grids never collide.
# Default derived from methods + run range; MUST match the grid job's tag (same
# EPA_DE_METHODS + EPA_RUN_START/END => same default). Override with EPA_GRID_TAG.
_safe_methods="${EPA_DE_METHODS//,/-}"
EPA_GRID_TAG="${EPA_GRID_TAG:-${_safe_methods}_runs$(printf '%02d' "$EPA_RUN_START")-$(printf '%02d' "$EPA_RUN_END")}"

cd "${PBS_O_WORKDIR:-$PWD}"
module load apptainer 2>/dev/null || true   # not required on CX3; harmless

WORKSPACE="${PBS_O_WORKDIR:-$PWD}"
SHARD_TAR_DIR="$EPA_DATALINK/Shards_tar"
CONTROL_DIR="$EPA_DATALINK/HPC_Control_Tar"
LOCAL_DATALINK="${TMPDIR:?TMPDIR not set}/epa-gtman/Datalink"

mkdir -p "$LOCAL_DATALINK/Shards" "$TMPDIR/home" "$CONTROL_DIR"

echo "================ EPA gt+manifest ================"
echo "grid tag      : $EPA_GRID_TAG   (run range $EPA_RUN_START-$EPA_RUN_END of $EPA_N_RUNS)"
echo "methods       : $EPA_DE_METHODS    dataset: $EPA_SHARD_DATASET    chunks: $EPA_N_CHUNKS"
echo "control tar   : $CONTROL_DIR/epa-control-${EPA_GRID_TAG}.tar"
echo "================================================"

# 1. stage shards into LOCAL scratch (never RDS)
for CT in Astro Micro Oligo; do
  tarf="$SHARD_TAR_DIR/${CT}_${EPA_SHARD_DATASET}.tar"
  [ -f "$tarf" ] || { echo "FATAL: shard tar missing: $tarf" >&2; exit 3; }
  tar xf "$tarf" -C "$LOCAL_DATALINK/Shards"
done

run_step() {  # mode steps
  local mode="$1" steps="$2"
  apptainer exec --cleanenv --no-home \
    --bind "$WORKSPACE:/workspace" \
    --bind "$LOCAL_DATALINK:/workspace/Datalink" \
    --env POWER_ANALYSIS_ROOT=/workspace \
    --env HOME="$TMPDIR/home" \
    --env DOWNSAMPLE_MODE="$mode" \
    --env JOB_N_CHUNKS="$EPA_N_CHUNKS" \
    --env SHARD_DATASET="$EPA_SHARD_DATASET" \
    --env DE_METHODS="$EPA_DE_METHODS" \
    --env N_ROBUSTNESS_RUNS="$EPA_N_RUNS" \
    --env RUN_START="$EPA_RUN_START" \
    --env RUN_END="$EPA_RUN_END" \
    --env POWER_ANALYSIS_FORCE_RECALC=false \
    --env RENV_CONFIG_AUTOLOADER_ENABLED=FALSE \
    "$EPA_SIF" \
    Rscript /workspace/R/cartesian_downsampling/run_pipeline.R "$steps" "$EPA_NCPUS"
}

# 2. ground truth once, then per-mode manifests
run_step cells 1      # ground truth (content mode-independent, but WRITTEN per-mode)

# 2b. mirror cells-mode ground truth into the reads tree. GT content is identical
#     across modes (01_Generate_Ground_Truth.R aggregates ALL cells, n_cells=NA,
#     and the donor-split seed is SEED_BASE + run_id — neither depends on mode),
#     but config.R writes GT to a MODE-SPECIFIC path
#     (results_base_dir <- .../<CT>/<Dataset>/<mode>/...). So running GT in cells
#     mode alone leaves the reads tree empty, and both the reads manifest (step
#     1.5 below) and the reads grid array (cx3-grid.pbs) then fail to find their
#     validation donors. Copy the GT artifacts across so reads has an identical set.
while IFS= read -r -d '' src; do
  dst="${src/\/cells\//\/reads\/}"
  mkdir -p "$(dirname "$dst")"
  cp -f "$src" "$dst"
done < <(find "$LOCAL_DATALINK/Cartesian_Downsampling" -path '*/cells/*' \
           \( -name 'Ground_Truth*.qs' -o -name 'Validation_Donors.qs' \
              -o -name '.ground_truth_complete' \) -print0)

run_step cells 1.5    # cells manifest
run_step reads 1.5    # reads manifest

# 3. pack control set into ONE tar on RDS (atomic). Paths relative to Datalink so
#    the grid's copy_control_files unpacks them back under Datalink/ verbatim.
TS="$(date +%Y%m%d-%H%M%S)"
final="$CONTROL_DIR/epa-control-${EPA_GRID_TAG}.tar"
tmp="$CONTROL_DIR/.epa-control-${EPA_GRID_TAG}.$$.partial.tar"
listf="$TMPDIR/.control.lst"
( cd "$LOCAL_DATALINK" && \
  find Cartesian_Downsampling \
       \( -path '*/_hpc_job_manifests/*' \
          -o -name 'Ground_Truth*.qs' \
          -o -name 'Validation_Donors.qs' \
          -o -name '.ground_truth_complete' \) -print0 ) > "$listf"
[ -s "$listf" ] || { echo "FATAL: nothing to pack into control tar" >&2; exit 5; }
( cd "$LOCAL_DATALINK" && tar --null -T "$listf" -cf "$tmp" )
mv -f "$tmp" "$final"
cp -f "$final" "$CONTROL_DIR/epa-control-${EPA_GRID_TAG}-$TS.tar"
echo "CONTROL TAR -> $final  (tag: $EPA_GRID_TAG, provenance: epa-control-${EPA_GRID_TAG}-$TS.tar)"
