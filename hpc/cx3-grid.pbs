#!/usr/bin/env bash
# ==============================================================================
# EPA Cartesian downsampling grid — Imperial CX3 PBS array job
# ==============================================================================
# REBUILT 2026-06-29 from the project's HPC-staging design after the original
# hpc/ scripts were lost (deleted on iclneuro during a move, deletion mirrored
# back to CBERT by Syncthing; never committed to git so unrecoverable). This is
# a faithful reconstruction of the agreed behaviour, NOT a byte-recovered file.
# Validate with `bash -n` (passes) and a MINI_RUN smoke test before the full
# submit. Resource directives (ncpus/mem) are best-effort — confirm against your
# allocation.
#
# GOLDEN HPC RULE (see data/workspace/skills/hpc.md): tar everything, move big,
# compute on node-local $TMPDIR. RDS only ever sees big files:
#   IN : shard tars (Shards_tar/<CT>_<Dataset>.tar) + one control tar
#   OUT: one result tar per (mode, chunk)
# Never detar onto RDS. Never read loose shards off RDS. Never write microfiles.
#
# MODE = split (default): a single 80-task array does reads FIRST then cells.
#   index 1..N        -> reads,  chunk = index
#   index N+1..2N     -> cells,  chunk = index - N        (N = EPA_N_CHUNKS)
# Cells run SECOND so already-banked cells tars flash past as instant skips at
# the tail while fresh reads work runs first. chunk_archive_exists() keys on
# (mode, chunk), not on array index, so banked work is reused regardless of the
# index it lands on.
#
# Submit (split, 80 tasks, 20 concurrent):
#   qsub -J 1-80%20 \
#        -v EPA_N_CHUNKS=40,EPA_SIF=$PWD/epa-cx3-2026-07-19.sif,EPA_DATALINK=$PWD/Datalink \
#        hpc/cx3-grid.pbs
#   # In split mode the -J upper bound MUST equal 2 * EPA_N_CHUNKS.
# Single-mode (legacy): EPA_CARTESIAN_MODE=cells|reads with -J 1-40%20.
#
# RUN RANGE + GRID TAG (two independent levers, see cx3-gt-manifest.pbs first):
#   * Incremental robustness runs — compute only runs 6-10 (after 1-5 banked):
#       qsub -J 1-80%20 \
#            -v EPA_RUN_START=6,EPA_RUN_END=10,EPA_N_RUNS=10,EPA_N_CHUNKS=40,\
# EPA_SIF=$PWD/epa-cx3-2026-07-19.sif,EPA_DATALINK=$PWD/Datalink hpc/cx3-grid.pbs
#     Run 1-5 are untouched (deterministic seeds). Build the matching control
#     tar first: cx3-gt-manifest.pbs with the SAME EPA_RUN_START/END.
#   * A fully separate grid (e.g. dreamlet) — set EPA_DE_METHODS=dreamlet; the
#     default grid tag becomes `dreamlet_runs01-10`, so its markers/tars/control
#     tar live under a different namespace and cannot clash with the deseq grid.
#   The grid tag (default <methods>_runs<START>-<END>, override EPA_GRID_TAG)
#   scopes: HPC_Control_Tar/epa-control-<tag>.tar, HPC_Result_Tars/incoming/<tag>/,
#   HPC_Result_Tars/done/<tag>/. Harvest a tag with:
#       bash hpc/harvest-grid-results.sh Datalink <tag>
# ==============================================================================
#PBS -N epa-de-grid
#PBS -l select=1:ncpus=24:mem=200gb
#PBS -l walltime=72:00:00
#PBS -j oe

set -euo pipefail

# ---- inputs -------------------------------------------------------------------
: "${EPA_SIF:?set EPA_SIF to the apptainer .sif path}"
: "${EPA_DATALINK:?set EPA_DATALINK to the RDS Datalink path}"
EPA_N_CHUNKS="${EPA_N_CHUNKS:-40}"
EPA_CARTESIAN_MODE="${EPA_CARTESIAN_MODE:-split}"
EPA_DE_METHODS="${EPA_DE_METHODS:-deseq2,edger,limma}"
EPA_SHARD_DATASET="${EPA_SHARD_DATASET:-Roussos}"
EPA_NCPUS="${EPA_NCPUS:-24}"

# Robustness run range for THIS grid (R-side RUN_START/RUN_END). Defaults to the
# full 1..EPA_N_RUNS set. For an incremental extension set e.g. EPA_RUN_START=6
# EPA_RUN_END=10 — seeds are deterministic so runs 1..5 are untouched and 6..10
# are fresh/disjoint. EPA_N_RUNS is the project TOTAL (R validates END <= total).
EPA_RUN_START="${EPA_RUN_START:-1}"
EPA_RUN_END="${EPA_RUN_END:-10}"
EPA_N_RUNS="${EPA_N_RUNS:-10}"

# Grid tag — namespaces done-markers + result tars + the control tar so that
# independent grids NEVER collide (a dreamlet-only grid, or a different run
# range, or a different method set). Default is derived from the DE methods and
# the run range, e.g. `deseq2-edger-limma_runs06-10`. Because dreamlet has a
# different EPA_DE_METHODS it gets a different default tag automatically, so the
# two grids can even run concurrently. Override explicitly with EPA_GRID_TAG.
# MUST match the tag used by the cx3-gt-manifest.pbs job that built the control
# tar (same EPA_DE_METHODS + EPA_RUN_START/END => same default tag).
_safe_methods="${EPA_DE_METHODS//,/-}"
EPA_GRID_TAG="${EPA_GRID_TAG:-${_safe_methods}_runs$(printf '%02d' "$EPA_RUN_START")-$(printf '%02d' "$EPA_RUN_END")}"

cd "${PBS_O_WORKDIR:-$PWD}"
# Apptainer is always available on CX3 — no `module load` required. The guarded
# load below is harmless on systems where it is module-managed.
module load apptainer 2>/dev/null || true

WORKSPACE="${PBS_O_WORKDIR:-$PWD}"
SHARD_TAR_DIR="$EPA_DATALINK/Shards_tar"
# Control tar + result dirs are tag-scoped so this grid is isolated from every
# other (different methods / run range). The gt-manifest job writes the matching
# epa-control-<tag>.tar; markers and result tars live under <incoming|done>/<tag>/.
CONTROL_TAR="$EPA_DATALINK/HPC_Control_Tar/epa-control-${EPA_GRID_TAG}.tar"
RESULT_INCOMING="$EPA_DATALINK/HPC_Result_Tars/incoming/$EPA_GRID_TAG"
RESULT_DONE="$EPA_DATALINK/HPC_Result_Tars/done/$EPA_GRID_TAG"

# ---- resolve array index -> (mode, chunk) ------------------------------------
IDX="${PBS_ARRAY_INDEX:-1}"
case "$EPA_CARTESIAN_MODE" in
  split)
    if   [ "$IDX" -ge 1 ] && [ "$IDX" -le "$EPA_N_CHUNKS" ]; then
      RUN_MODE="reads"; RUN_CHUNK="$IDX"
    elif [ "$IDX" -gt "$EPA_N_CHUNKS" ] && [ "$IDX" -le $((2 * EPA_N_CHUNKS)) ]; then
      RUN_MODE="cells"; RUN_CHUNK=$((IDX - EPA_N_CHUNKS))
    else
      echo "FATAL: array index $IDX out of range for split mode (expect 1..$((2 * EPA_N_CHUNKS)))" >&2
      exit 2
    fi
    ;;
  cells|reads)
    RUN_MODE="$EPA_CARTESIAN_MODE"; RUN_CHUNK="$IDX"
    ;;
  both)
    RUN_MODE="both"; RUN_CHUNK="$IDX"
    ;;
  *)
    echo "FATAL: unknown EPA_CARTESIAN_MODE='$EPA_CARTESIAN_MODE' (expect split|cells|reads|both)" >&2
    exit 2
    ;;
esac

LOCAL_DATALINK="${TMPDIR:?TMPDIR not set}/epa-${RUN_MODE}-${RUN_CHUNK}/Datalink"

# ---- helpers ------------------------------------------------------------------
chunk_archive_exists() {  # mode chunk -> 0 if already complete
  local mode="$1" chunk="$2"
  if [ -f "$RESULT_DONE/$mode/chunk_${chunk}.done" ]; then return 0; fi
  if [ -f "$RESULT_INCOMING/epa_${mode}_chunk_${chunk}.tar" ]; then return 0; fi
  return 1
}

stage_in_shards() {  # extract shard tars to LOCAL scratch only
  mkdir -p "$LOCAL_DATALINK/Shards"
  local CT tarf
  for CT in Astro Micro Oligo; do
    tarf="$SHARD_TAR_DIR/${CT}_${EPA_SHARD_DATASET}.tar"
    [ -f "$tarf" ] || { echo "FATAL: shard tar missing: $tarf" >&2; exit 3; }
    tar xf "$tarf" -C "$LOCAL_DATALINK/Shards"
  done
}

copy_control_files() {  # bring manifests + ground truth onto LOCAL scratch
  if [ -f "$CONTROL_TAR" ]; then
    local local_tar="$TMPDIR/epa-control.tar"
    cp "$CONTROL_TAR" "$local_tar"
    if tar tf "$local_tar" | grep -qE '(^/|(^|/)\.\.(/|$))'; then
      echo "FATAL: unsafe path in control tar $CONTROL_TAR" >&2; exit 4
    fi
    mkdir -p "$LOCAL_DATALINK"
    tar xf "$local_tar" -C "$LOCAL_DATALINK"
  else
    echo "WARN: control tar $CONTROL_TAR absent; copying loose control files from RDS" >&2
    local src="$EPA_DATALINK/Cartesian_Downsampling"
    [ -d "$src" ] || { echo "FATAL: no control tar and no $src to copy from" >&2; exit 4; }
    mkdir -p "$LOCAL_DATALINK/Cartesian_Downsampling/_hpc_job_manifests"
    cp -a "$src/_hpc_job_manifests/." \
          "$LOCAL_DATALINK/Cartesian_Downsampling/_hpc_job_manifests/" 2>/dev/null || true
    ( cd "$src" && find . \( -name 'Ground_Truth*.qs' -o -name 'Validation_Donors.qs' \
                             -o -name '.ground_truth_complete' \) -print0 ) \
      | while IFS= read -r -d '' f; do
          mkdir -p "$LOCAL_DATALINK/Cartesian_Downsampling/$(dirname "$f")"
          cp -a "$src/$f" "$LOCAL_DATALINK/Cartesian_Downsampling/$f"
        done
  fi
}

stage_out_mode() {  # tar this chunk's mode results to RDS, atomically, + done marker
  local mode="$1" chunk="$2"
  mkdir -p "$RESULT_INCOMING" "$RESULT_DONE/$mode"
  local final="$RESULT_INCOMING/epa_${mode}_chunk_${chunk}.tar"
  local tmp="$RESULT_INCOMING/.epa_${mode}_chunk_${chunk}.$$.partial.tar"
  local listf="$TMPDIR/.stageout_${mode}_${chunk}.lst"
  ( cd "$LOCAL_DATALINK" && \
    find Cartesian_Downsampling -type d -path "*/$EPA_SHARD_DATASET/$mode" -print0 ) > "$listf"
  if [ ! -s "$listf" ]; then
    echo "FATAL: no '$mode' result dirs to stage out for chunk $chunk (step 2 produced nothing?)" >&2
    exit 5
  fi
  ( cd "$LOCAL_DATALINK" && tar --null -T "$listf" -cf "$tmp" )
  mv -f "$tmp" "$final"
  : > "$RESULT_DONE/$mode/chunk_${chunk}.done"
  echo "STAGED OUT: $final"
}

run_one_mode() {  # skip-or-run a single (mode, chunk)
  local mode="$1" chunk="$2"
  if chunk_archive_exists "$mode" "$chunk"; then
    echo "SKIP: $mode chunk $chunk already complete (done marker or result tar present)"
    return 0
  fi
  apptainer exec --cleanenv --no-home \
    --bind "$WORKSPACE:/workspace" \
    --bind "$LOCAL_DATALINK:/workspace/Datalink" \
    --env POWER_ANALYSIS_ROOT=/workspace \
    --env HOME="$TMPDIR/home" \
    --env DOWNSAMPLE_MODE="$mode" \
    --env JOB_CHUNK="$chunk" \
    --env JOB_N_CHUNKS="$EPA_N_CHUNKS" \
    --env SHARD_DATASET="$EPA_SHARD_DATASET" \
    --env DE_METHODS="$EPA_DE_METHODS" \
    --env N_ROBUSTNESS_RUNS="$EPA_N_RUNS" \
    --env RUN_START="$EPA_RUN_START" \
    --env RUN_END="$EPA_RUN_END" \
    --env POWER_ANALYSIS_FORCE_RECALC=false \
    --env RENV_CONFIG_AUTOLOADER_ENABLED=FALSE \
    "$EPA_SIF" \
    Rscript /workspace/R/cartesian_downsampling/run_pipeline.R 2 "$EPA_NCPUS"
  stage_out_mode "$mode" "$chunk"
}

# ---- run ----------------------------------------------------------------------
echo "================ EPA grid array ================"
echo "array index   : $IDX  (mode=$EPA_CARTESIAN_MODE)"
echo "resolved      : run_mode=$RUN_MODE  chunk=$RUN_CHUNK / $EPA_N_CHUNKS"
echo "grid tag      : $EPA_GRID_TAG   (run range $EPA_RUN_START-$EPA_RUN_END of $EPA_N_RUNS)"
echo "ncpus         : $EPA_NCPUS    methods: $EPA_DE_METHODS    dataset: $EPA_SHARD_DATASET"
echo "RDS Datalink  : $EPA_DATALINK"
echo "local Datalink: $LOCAL_DATALINK"
echo "control tar   : $CONTROL_TAR"
echo "result tars   : $RESULT_INCOMING"
echo "done markers  : $RESULT_DONE"
echo "================================================"

mkdir -p "$TMPDIR/home" "$LOCAL_DATALINK"
stage_in_shards
copy_control_files

if [ "$RUN_MODE" = "both" ]; then
  run_one_mode cells "$RUN_CHUNK"
  run_one_mode reads "$RUN_CHUNK"
else
  run_one_mode "$RUN_MODE" "$RUN_CHUNK"
fi

rm -rf "$LOCAL_DATALINK" 2>/dev/null || true
echo "================ done index $IDX ================"
