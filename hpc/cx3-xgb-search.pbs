#!/usr/bin/env bash
# ==============================================================================
# XGBoost power model — Stage B: hyperparameter search array. Imperial CX3.
# ==============================================================================
# ONE array task = ONE hyperparameter config (row k of param_grid in
# 02_Fit_XGBoost.R). Each task stages the single aggregated-data tar to LOCAL
# scratch, trains the full model at config k (grouped-by-gene CV for the score +
# early-stopped nrounds, then a full fit), and writes ONE result tar:
#   Power_Curve_Fitting/Models/xgboost/search/config_<k>/
#     {booster.ubj, booster.qs, feature_spec.qs, cv_metrics.csv, config.json}
#
#   IN  (RDS): HPC_XGB_Input/xgb-aggregated-<tag>.tar   (from Stage A)
#   OUT (RDS): HPC_XGB_Search/incoming/<tag>/config_<k>.tar
#
# The array upper bound MUST equal nrow(param_grid). With the default grid
# (max_depth{3,4,6} x eta{0.03,0.1} x min_child_weight{1,10}) that is 12.
# Confirm before submit:
#   apptainer exec $PWD/epa-cx3-2026-07-19.sif Rscript -e \
#     'source("R/power_curve_fitting/config.R"); \
#      print(nrow(expand.grid(max_depth=c(3,4,6),eta=c(.03,.1),min_child_weight=c(1,10),subsample=.8,colsample_bytree=.8)))'
#
# Submit (12-config grid, all concurrent — each task is light):
#   qsub -J 1-12 \
#        -v EPA_SIF=$PWD/epa-cx3-2026-07-19.sif,EPA_DATALINK=$PWD/Datalink \
#        hpc/cx3-xgb-search.pbs
# ==============================================================================
#PBS -N epa-xgb-search
#PBS -l select=1:ncpus=8:mem=64gb
# Observed 2026-07-24: longest array subjob 33min at the OLD 2000-round cap. With
# the cap now 5000 the eta=0.03 configs can train ~2.5x longer, so bump to 4h for
# headroom. Still <=8h => short-queue eligible (8 cpus + <=8h) => fast queue start.
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail

: "${EPA_SIF:?set EPA_SIF to the apptainer .sif path}"
: "${EPA_DATALINK:?set EPA_DATALINK to the RDS Datalink path}"
EPA_DE_METHODS="${EPA_DE_METHODS:-deseq2,edger,limma}"
EPA_NCPUS="${EPA_NCPUS:-8}"
_safe_methods="${EPA_DE_METHODS//,/-}"
EPA_XGB_TAG="${EPA_XGB_TAG:-${_safe_methods}_runs01-10}"

cd "${PBS_O_WORKDIR:-$PWD}"
module load apptainer 2>/dev/null || true

WORKSPACE="${PBS_O_WORKDIR:-$PWD}"
AGG_TAR="$EPA_DATALINK/HPC_XGB_Input/xgb-aggregated-${EPA_XGB_TAG}.tar"
SEARCH_INCOMING="$EPA_DATALINK/HPC_XGB_Search/incoming/$EPA_XGB_TAG"

IDX="${PBS_ARRAY_INDEX:-1}"
LOCAL_DATALINK="$TMPDIR/epa-xgb-search-${IDX}/Datalink"
mkdir -p "$LOCAL_DATALINK" "$TMPDIR/home" "$SEARCH_INCOMING"

echo "================ EPA xgb-search ================"
echo "config index  : $IDX"
echo "aggregated tar: $AGG_TAR"
echo "search out    : $SEARCH_INCOMING/config_${IDX}.tar"
echo "================================================"

# ---- skip if this config already banked ---------------------------------------
if [ -f "$SEARCH_INCOMING/config_${IDX}.tar" ]; then
  echo "SKIP: config $IDX already complete"
  exit 0
fi

# ---- stage aggregated data to LOCAL scratch -----------------------------------
[ -f "$AGG_TAR" ] || { echo "FATAL: aggregated tar missing: $AGG_TAR (run Stage A first)" >&2; exit 3; }
if tar tf "$AGG_TAR" | grep -qE '(^/|(^|/)\.\.(/|$))'; then
  echo "FATAL: unsafe path in $AGG_TAR" >&2; exit 4
fi
tar xf "$AGG_TAR" -C "$LOCAL_DATALINK"

# ---- train exactly this config ------------------------------------------------
apptainer exec --cleanenv --no-home \
  --bind "$WORKSPACE:/workspace" \
  --bind "$LOCAL_DATALINK:/workspace/Datalink" \
  --env POWER_ANALYSIS_ROOT=/workspace \
  --env HOME="$TMPDIR/home" \
  --env XGB_CONFIG_INDEX="$IDX" \
  --env XGB_NTHREAD="$EPA_NCPUS" \
  --env RENV_CONFIG_AUTOLOADER_ENABLED=FALSE \
  "$EPA_SIF" \
  Rscript /workspace/R/power_curve_fitting/02_Fit_XGBoost.R

# ---- stage out one config tar to RDS (atomic) ---------------------------------
CFG_REL="Power_Curve_Fitting/Models/xgboost/search/config_${IDX}"
[ -d "$LOCAL_DATALINK/$CFG_REL" ] || { echo "FATAL: config $IDX produced no output dir" >&2; exit 5; }
final="$SEARCH_INCOMING/config_${IDX}.tar"
tmp="$SEARCH_INCOMING/.config_${IDX}.$$.partial.tar"
( cd "$LOCAL_DATALINK" && tar -cf "$tmp" "$CFG_REL" )
mv -f "$tmp" "$final"
echo "CONFIG TAR -> $final"

rm -rf "$LOCAL_DATALINK" 2>/dev/null || true
echo "================ xgb-search done index $IDX ================"
