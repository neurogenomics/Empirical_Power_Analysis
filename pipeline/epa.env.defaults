# =============================================================================
# pipeline/epa.env.defaults -- settings for one reproduction run.
# -----------------------------------------------------------------------------
# run.sh copies this file to WORKDIR/epa.env on first use. Edit the copy in the
# work directory, not this file. The values below reproduce the paper.
# Plain shell assignments; values may contain commas (they are never passed
# through qsub -v).
# =============================================================================

# Container image. Default: WORKDIR/epa.sif. Optionally pin its checksum so a
# run refuses to start with a different image.
#EPA_SIF=/path/to/empirical-power-analysis.sif
EPA_SIF_SHA256=""

# ---- scientific settings (changing these changes the paper's numbers) --------
EPA_N_RUNS=10                          # robustness runs (independent donor splits)
EPA_DE_METHODS="deseq2,edger,limma"    # DE methods in the grid

# ---- grid partitioning (does NOT change results: every grid job's seed depends
# only on run, design point and iteration, never on the chunk it lands in) ------
EPA_GRID_CHUNKS=40                     # chunks per mode (cells, reads): 80 array tasks
EPA_GRID_CONCURRENCY=20                # at most this many array tasks of one stage running at once
EPA_AD_GRID_CHUNKS=20                  # chunks of the AD vs control grid (cells mode only)

# ---- cluster ----------------------------------------------------------------------
EPA_PBS_ACCOUNT=""                     # optional `#PBS -P` project/account
# Per-stage resource overrides, "ncpus mem walltime" (defaults in stages.tsv), e.g.
#EPA_RES_grid="24 200gb 48:00:00"

# ---- behaviour ----------------------------------------------------------------------
EPA_VERIFY_INPUTS=true                 # check raw/ against pipeline/inputs.sha256 in the first job
EPA_KEEP_SCRATCH=false                 # keep node-local scratch after a job (debugging)
