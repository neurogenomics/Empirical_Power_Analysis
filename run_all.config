# =============================================================================
# run_all.config — defaults for run_all.sh
# =============================================================================
# Sourced as a bash file. Override any of these on the command line.
# Edit values here for permanent changes; pass flags to run_all.sh for one-offs.
# =============================================================================

# ---- Compute ----------------------------------------------------------------
# Maximum cores any single Rscript step is allowed to use.
# Memory is the usual bottleneck on this box, so 24 is a sensible cap.
MAX_CORES=24

# ---- Caching ----------------------------------------------------------------
# If "true", every config's FORCE_RECALC defaults to TRUE (regenerate everything).
# If "false", pipelines skip work whose outputs already exist on disk
# (controlled by each pipeline's own FORCE_RECALC checks).
# CLI: --no-overwrite sets this to "false"; --force sets it to "true".
FORCE_RECALC=false

# ---- Cartesian downsampling mode --------------------------------------------
# "cells", "reads", or "both". "both" runs cells then reads (sequential).
# Power curve fitting consumes both, so "both" is the default for full reruns.
CARTESIAN_MODE=both

# ---- Stage selection --------------------------------------------------------
# Comma-separated stage names to skip. Useful examples:
#   SKIP_STAGES="eda_roussos,de_diagnostics"   # skip diagnostics-only stages
#   SKIP_STAGES="sharding"                      # shards already exist on disk
SKIP_STAGES=""

# Comma-separated stage names to run only (overrides SKIP_STAGES if set).
ONLY_STAGES=""

# Stage to start from (skips everything before it). Useful for resume.
#   FROM_STAGE="cartesian_downsampling"
FROM_STAGE=""

# ---- Failure behaviour ------------------------------------------------------
# If "true", abort the whole pipeline on the first stage failure.
# If "false", log the failure and continue to the next stage.
STOP_ON_FAIL=false

# ---- Logging ----------------------------------------------------------------
# Where per-run log directories are written. Each invocation creates a
# timestamped subdirectory. Outputs sync back to CBERT via Syncthing.
LOG_BASE="Datalink/Run_Output_Logs/run_all"
